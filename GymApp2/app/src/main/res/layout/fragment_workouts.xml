<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        style="@style/Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_workouts" />

    <!-- SOLO PARA PRUEBAS: abre Ejercicios hasta que esté la pantalla real de Workouts -->
    <Button
        android:id="@+id/btnProbarEjercicios"
        style="@style/Boton.Negro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/ejercicios_titulo" />
</LinearLayout>