<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollEjercicios"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="120dp">

        <!-- Flecha volver -->
        <ImageView
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:contentDescription="@string/volver"
            android:src="@drawable/ic_volver"
            app:tint="@color/texto_principal" />

        <!-- Título + badge de completado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNombreWorkout"
                style="@style/Titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/txtBadgeCompletado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_badge_completado"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/workout_completado"
                android:textAllCaps="true"
                android:textColor="@color/texto_principal"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Nivel · nº ejercicios · minutos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgNivel"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rombo" />

            <TextView
                android:id="@+id/txtResumenWorkout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Imagen del workout + botón vídeo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/fondo_imagen_workout">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_gymapp"
                app:tint="@color/boton_principal_texto" />

            <Button
                android:id="@+id/btnVideo"
                style="@style/Boton.Negro"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:minHeight="36dp"
                android:text="@string/workout_ver_video"
                android:textColor="@color/texto_principal"
                android:textSize="11sp"
                app:backgroundTint="@color/fondo_pantalla" />
        </FrameLayout>

        <!-- Buscador -->
        <EditText
            android:id="@+id/etBuscar"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/ejercicios_buscar"
            android:inputType="text" />

        <!-- Progreso -->
        <TextView
            android:id="@+id/txtProgreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAllCaps="true"
            android:textColor="@color/texto_secundario"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/barraProgreso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressBackgroundTint="@color/linea"
            android:progressTint="@color/texto_principal" />

        <!-- Mensaje si no hay ejercicios -->
        <TextView
            android:id="@+id/txtSinEjercicios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/error_sin_ejercicios"
            android:textColor="@color/texto_secundario"
            android:visibility="gone" />

        <!-- Lista de ejercicios -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />

        <!-- Marcar / desmarcar workout -->
        <Button
            android:id="@+id/btnMarcarWorkout"
            style="@style/Boton.Negro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/completar_workout" />

        <Button
            android:id="@+id/btnDesmarcarWorkout"
            style="@style/Boton.Blanco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/desmarcar_workout"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>