<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="120dp">

        <!-- Cabecera: flecha + título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnVolver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:contentDescription="@string/volver"
                android:src="@drawable/ic_volver"
                app:tint="@color/texto_principal" />

            <TextView
                style="@style/Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/perfil_titulo" />
        </LinearLayout>

        <!-- Foto -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgFoto"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_foto_perfil"
            android:contentDescription="@string/desc_foto_perfil"
            android:padding="20dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_perfil"
            app:shapeAppearanceOverlay="@style/ImagenCircular"
            app:tint="@color/texto_placeholder" />

        <!-- Botones de la foto -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCamara"
                style="@style/Boton.Negro"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:text="@string/perfil_camara"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBorrarFoto"
                style="@style/Boton.Blanco"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:minHeight="40dp"
                android:text="@string/borrar"
                android:textColor="@color/error"
                android:textSize="12sp"
                app:strokeColor="@color/error" />
        </LinearLayout>

        <!-- Nombre -->
        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registro_nombre" />

        <EditText
            android:id="@+id/etNombre"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />

        <!-- Apellidos -->
        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registro_apellidos" />

        <EditText
            android:id="@+id/etApellidos"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />

        <!-- Email (login), no editable -->
        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_email_login" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etEmail"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_input_bloqueado"
                android:enabled="false"
                android:inputType="textEmailAddress"
                android:textColor="@color/texto_placeholder" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="14dp"
                android:text="@string/no_editable"
                android:textAllCaps="true"
                android:textColor="@color/texto_placeholder"
                android:textSize="10sp" />
        </FrameLayout>

        <!-- Fecha de nacimiento (se elegirá con un calendario) -->
        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registro_fecha_nacimiento" />

        <EditText
            android:id="@+id/etFecha"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:inputType="none" />

        <!-- Contraseña nueva -->
        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_nueva_password" />

        <EditText
            android:id="@+id/etPassword"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />

        <!-- Repetir contraseña -->
        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_repetir_password" />

        <EditText
            android:id="@+id/etRepetirPassword"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />

        <!-- Nivel, no editable -->
        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_nivel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgNivel"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rombo"
                app:tint="@color/nivel_novato" />

            <TextView
                android:id="@+id/txtNivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/nivel_novato"
                android:textColor="@color/nivel_novato"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/no_editable"
                android:textColor="@color/texto_placeholder"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tema -->
        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_tema" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/fondo_selector"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTemaClaro"
                style="@style/OpcionSelector"
                android:background="@drawable/fondo_opcion_activa"
                android:text="@string/tema_claro"
                android:textColor="@color/boton_principal_texto" />

            <TextView
                android:id="@+id/btnTemaOscuro"
                style="@style/OpcionSelector"
                android:text="@string/tema_oscuro" />
        </LinearLayout>

        <!-- Idioma -->
        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_idioma" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/fondo_selector"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnIdiomaEs"
                style="@style/OpcionSelector"
                android:background="@drawable/fondo_opcion_activa"
                android:text="@string/idioma_cod_es"
                android:textColor="@color/boton_principal_texto" />

            <TextView
                android:id="@+id/btnIdiomaEn"
                style="@style/OpcionSelector"
                android:text="@string/idioma_cod_en" />

            <TextView
                android:id="@+id/btnIdiomaKa"
                style="@style/OpcionSelector"
                android:text="@string/idioma_cod_ka" />
        </LinearLayout>

        <!-- Guardar -->
        <Button
            android:id="@+id/btnGuardar"
            style="@style/Boton.Negro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/perfil_guardar" />

    </LinearLayout>
</ScrollView>